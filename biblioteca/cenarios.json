{
  // Cenários reutilizáveis: fundo + elementos fixos (+ clima, câmera, ações...).
  // Na cena:  { "cenario": "acampamento", "elementos": [ ...personagens... ], "acoes": [...] }
  // - Elemento da cena com o mesmo "id" de um do cenário ajusta aquele elemento.
  // - "remover": ["fogo"] tira elementos do cenário só naquela cena.
  // - Campos da cena (fundo, clima, transicao, camera...) vencem os do cenário.

  "acampamento": {
    "fundo": "floresta-noite",
    "elementos": [
      { "id": "fogo", "sprite": "fogueira", "x": 0.2, "z": 0.2 },
      { "id": "pinheiro1", "sprite": "pinheiro", "x": -7, "z": -2 },
      { "id": "pinheiro2", "sprite": "pinheiro", "x": 6.5, "z": -2.5, "semente": 3 },
      { "id": "pedra", "sprite": "pedra", "x": -4.5, "z": 0.3 }
    ]
  },
