{
  // Personagens do canal: defina uma vez, use em qualquer cena de qualquer projeto:
  //   { "id": "heroi", "personagem": "protagonista", "x": -2 }
  // Qualquer campo pode ser ajustado na cena (o da cena vence): "escala", "virado", "cores"...
  //
  // Com um PNG seu (coloque o arquivo em biblioteca/sprites/):
  //   "joao": { "sprite": "arquivo:joao.png", "quadros": 4, "fps": 8, "sombra": true,
  //             "animacoes": { "parado": [0], "andando": [1, 2, 3, 2] }, "voz": 1.1 }

  "protagonista": { "sprite": "heroi", "voz": 1.0 },
  "companheira":  { "sprite": "amiga", "voz": 1.3 },
  "anciao":       { "sprite": "velho", "voz": 0.8 },
  "crianca":      { "sprite": "crianca", "voz": 1.5 },
  "guarda":       { "sprite": "guarda", "voz": 0.9 },
  "mestre":       { "sprite": "mago", "voz": 0.75 },
  "vilao": {
    "sprite": "pessoa", "voz": 0.65,
    "cores": { "h": "#1a1a22", "H": "#2a2a36", "r": "#4a2a6a", "R": "#2e1a46", "b": "#1e1e28", "B": "#121218" }
  },
  "mascote":      { "sprite": "slime", "voz": 1.7, "cores": { "g": "#5aa8f0", "l": "#b8e0ff", "G": "#2e64a8" } },
  "monstro":      { "sprite": "slime", "voz": 0.6 },

  // ---- Estilo RPG indie (vista de frente, contorno grosso). Ficam melhor com "zoom": 2 na câmera
  //      ou usando o cenário "cidade-rpg" / "batalha".
  //      menina-capa e robo-semaforo são as versões DETALHADAS (28x44, andar de lado e correr).
  //      As versões antigas (simples): "sprite": "menina-capa-antigo" / "robo-semaforo-antigo".
  "menina-capa":      { "sprite": "menina-capa", "voz": 1.2, "realce": 0.15 },
  "robo-semaforo":    { "sprite": "robo-semaforo", "voz": 0.7, "realce": 0.15 },
  "pombo-fofoqueiro": { "sprite": "pombo-fofoqueiro", "voz": 1.6 },
  "lixeira-timida":   { "sprite": "lixeira-timida", "voz": 1.2 },
  "cao-guarda":       { "sprite": "cao-guarda", "voz": 0.9 },
  "fantasma-metro":   { "sprite": "fantasma-metro", "voz": 1.4, "y": 0.4 },
  "coruja-banca":     { "sprite": "coruja-banca", "voz": 0.6 },
  "cone-agressivo":   { "sprite": "cone-agressivo", "voz": 0.8, "escala": 2 },
  "bueiro-olhos":     { "sprite": "bueiro-olhos", "voz": 0.5, "escala": 2 },

  // ---- Moradores da cidade (detalhados 28x44, andar e correr)
  "policial":   { "sprite": "policial", "voz": 0.9 },
  "prefeito":   { "sprite": "prefeito", "voz": 0.7 },
  "aluno":      { "sprite": "aluno", "voz": 1.4 },
  "aluna":      { "sprite": "aluna", "voz": 1.5 },
  "professora": { "sprite": "professora", "voz": 1.15 },
  "padeiro":    { "sprite": "padeiro", "voz": 0.85 },
  "caixa":      { "sprite": "caixa", "voz": 1.1 },
  // Nesse Mundo
  "policial-oculos": { "sprite": "policial-oculos", "voz": 0.9 },
  "prefeito-careca": { "sprite": "prefeito-careca", "voz": 0.7 },
  "cone-monstro":    { "sprite": "cone-monstro", "voz": 0.6 }
}
