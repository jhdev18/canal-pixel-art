{
  // PROTÓTIPO (não aprovado) — monstros de sombra em 3D, desenhados em alta resolução sobre o mundo pixel art.
  // Ver sem renderizar vídeo: npm run previa -- prototipo-monstros
  // Elemento: { "id": "vulto", "monstro": "sombra-alta" | "tentaculos" | "massa-olhos", "x": 2, "olhar": "filho" }
  //   "aparecer" materializa o monstro (use "duracao" de 1.5 a 2.5 s); "sumir" desfaz em fumaça.
  //   "olhar": id de um personagem (olhos e tentáculos se voltam para ele). "aura": false tira o escurecimento em volta.
  //   "escala", "cor", "corBorda", "corOlhos", "quantidade" (tentáculos) são opcionais.
  "titulo": "Protótipo — monstros de sombra",
  "resolucao": [320, 180],
  "volumeBaloes": 0.4,
  "legendasNarracao": false,
  "cenas": [
    { // 1 — vulto surge na sala, de noite
      "fundo": "diorama-noite", "duracao": 5, "narracao": false, "transicao": "fade",
      "camera": { "x": 0.6, "y": 1.6875 }, "cameraFim": { "x": -0.2, "zoom": 1 },
      "elementos": [
        { "id": "comodo", "sprite": "casa-sala-noite", "x": 0, "y": -3.75 },
        { "id": "filho", "sprite": "menino-topete", "x": 2.5, "virado": "esquerda" },
        { "id": "vulto", "monstro": "sombra-alta", "x": -2.8, "y": 0.5, "olhar": "filho" } ],
      "acoes": [
        { "tipo": "aparecer", "alvo": "vulto", "inicio": 0.4, "duracao": 2.2 },
        { "tipo": "emocao", "alvo": "filho", "icone": "!", "inicio": 2.7 },
        { "tipo": "tremer", "intensidade": 0.5, "inicio": 2.7 },
        { "tipo": "mover", "alvo": "vulto", "para": -1.6, "inicio": 3, "duracao": 2 } ]
    },
    { // 2 — tentáculos saindo de baixo da cama
      "fundo": "diorama-noite", "duracao": 4, "narracao": false,
      "camera": { "x": -0.4, "y": 1.6875 }, "cameraFim": { "x": 0.4 },
      "elementos": [
        { "id": "comodo", "sprite": "casa-quarto-noite", "x": 0, "y": -3.75 },
        { "id": "tent", "monstro": "tentaculos", "x": -2.6, "y": 0.6, "olhar": "filho" },
        { "id": "filho", "sprite": "menino-topete", "x": 0.5 } ],
      "acoes": [
        { "tipo": "aparecer", "alvo": "tent", "inicio": 0.2, "duracao": 2 },
        { "tipo": "emocao", "alvo": "filho", "icone": "!", "inicio": 1.4 },
        { "tipo": "correr", "alvo": "filho", "para": 5, "inicio": 1.9, "duracao": 1.2 } ]
    },
    { // 3 — massa de olhos na cozinha de dia (contraste máximo)
      "fundo": "diorama", "duracao": 4, "narracao": false,
      "camera": { "x": 0, "y": 1.6875 }, "cameraFim": { "x": 0.5 },
      "elementos": [
        { "id": "comodo", "sprite": "casa-cozinha", "x": 0, "y": -3.75 },
        { "id": "mae", "sprite": "mae-avental", "x": -3, "voz": 1.1 },
        { "id": "massa", "monstro": "massa-olhos", "x": 2.2, "y": 0.3, "olhar": "mae" } ],
      "acoes": [
        { "tipo": "aparecer", "alvo": "massa", "inicio": 0.3, "duracao": 1.8 },
        { "tipo": "emocao", "alvo": "mae", "icone": "!", "inicio": 2.1 },
        { "tipo": "flash", "inicio": 2.1, "intensidade": 0.5 } ]
    },
    { // 4 — vulto no fim da rua (vista diagonal), some em fumaça
      "cenario": "rua-comercial-noite", "duracao": 4, "narracao": false, "seguir": "bia",
      "elementos": [
        { "id": "bia", "personagem": "menina-capa", "x": -6, "z": 0.6 },
        { "id": "vulto", "monstro": "sombra-alta", "x": 2, "z": 2.7, "olhar": "bia" } ],
      "acoes": [
        { "tipo": "andar", "alvo": "bia", "para": -3, "inicio": 0, "duracao": 2 },
        { "tipo": "emocao", "alvo": "bia", "icone": "?", "inicio": 2 },
        { "tipo": "sumir", "alvo": "vulto", "inicio": 2.4, "duracao": 1.5 } ]
    },
    { // 5 — tentáculos em frente à padaria, de dia (vista lateral)
      "cenario": "padaria", "duracao": 4, "narracao": false,
      "elementos": [
        { "id": "padeiro", "personagem": "padeiro", "x": -3 },
        { "id": "tent", "monstro": "tentaculos", "x": 2.5, "quantidade": 6, "olhar": "padeiro" } ],
      "acoes": [
        { "tipo": "aparecer", "alvo": "tent", "inicio": 0.3, "duracao": 2 },
        { "tipo": "emocao", "alvo": "padeiro", "icone": "!", "inicio": 1.5 },
        { "tipo": "tremer", "intensidade": 0.6, "inicio": 1.5 } ]
    }
  ]
}
